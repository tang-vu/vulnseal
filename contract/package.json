{
  "name": "@vulnseal/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../scripts/copy-contract-artifacts.mjs",
    "compact": "node ../scripts/compile-contract.mjs",
    "compact:skip-zk": "node ../scripts/compile-contract.mjs --skip-zk",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
