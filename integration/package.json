{
  "name": "@vulnseal/integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "@vulnseal/api": "0.1.0",
    "@vulnseal/contract": "0.1.0",
    "@vulnseal/shared": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lifecycle": "npm run build && node dist/local-lifecycle.js",
    "preprod:prepare": "npm run build && node --env-file-if-exists=.env.preprod dist/preprod-prepare.js",
    "preprod:lifecycle": "npm run build && node --env-file=.env.preprod dist/preprod-lifecycle.js",
    "preprod:verify": "npm run build && node dist/preprod-verify.js",
    "preprod:inspect-transactions": "npm run build && node dist/preprod-transaction-content.js",
    "test:run": "vitest run src/test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
