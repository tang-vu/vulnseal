# Public deployment settings; select the exact origin hosting the browser app.
CIPHERSTORE_PUBLISHED_PORT=8787
CIPHERSTORE_ALLOWED_ORIGIN=http://127.0.0.1:5173
CIPHERSTORE_MAX_STORED_BYTES=1073741824
CIPHERSTORE_MAX_STORED_BLOBS=10000
CIPHERSTORE_MAX_CONCURRENT_UPLOADS=16
CIPHERSTORE_REQUEST_TIMEOUT_MS=30000
CIPHERSTORE_MAX_CONNECTIONS=64
# Opt in only on an operator-controlled listener or behind a protected proxy.
CIPHERSTORE_METRICS_ENABLED=0
