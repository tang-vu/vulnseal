# SPDX-License-Identifier: Apache-2.0
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Cache-Control "no-cache"
	}
	# Routes use URL fragments; missing files must stay 404, including proving assets.
	@binary path *.prover *.verifier *.bzkir
	header @binary Content-Type application/octet-stream
	# Public, credential-free modules for the cross-origin submission entry widget.
	@widget path /assets/submission-widget.js /assets/program-invitation-*.js
	header @widget Access-Control-Allow-Origin "*"
	file_server
}
